{
  "redirects": [
    { "source": "/demo", "destination": "/approvals.html?demo=1", "permanent": false },
    { "source": "/d/:code", "destination": "/approvals.html?demo=1&src=dm&p=:code", "permanent": false },
    { "source": "/p/:code", "destination": "/proposal.html?p=:code", "permanent": false },
    { "source": "/k/:code", "destination": "/calendar.html?p=:code", "permanent": false },
    { "source": "/kalendar", "destination": "/calendar.html", "permanent": false }
  ],
  "rewrites": [
    { "source": "/", "destination": "/Adronis.dc.html" },
    { "source": "/full", "destination": "/Adronis-full.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'none'; object-src 'none'; base-uri 'self'" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/(.*).html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, must-revalidate" }
      ]
    },
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, must-revalidate" }
      ]
    }
  ]
}
